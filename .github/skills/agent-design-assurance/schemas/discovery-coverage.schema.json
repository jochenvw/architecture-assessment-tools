{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-design-assurance/discovery-coverage.schema.json",
  "title": "Discovery coverage",
  "description": "Generated by `ada.py render`. Coverage is reported separately from maturity; no overall application score is produced.",
  "type": "object",
  "required": ["schema_version", "generated_at", "profiles", "domains", "totals", "scoring_method"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "profiles": {"type": "array", "items": {"type": "string"}},
    "scoring_method": {"type": "string"},
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["domain", "title", "criteria_total", "not_applicable", "status_counts", "coverage_counts", "evidence_records", "maturity"],
        "additionalProperties": false,
        "properties": {
          "domain": {"type": "string"},
          "title": {"type": "string"},
          "criteria_total": {"type": "integer"},
          "not_applicable": {"type": "integer"},
          "status_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
          "coverage_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
          "evidence_records": {"type": "integer"},
          "maturity": {
            "type": "object",
            "required": ["scored", "unknown", "excluded_not_applicable", "distribution", "mean_of_scored"],
            "additionalProperties": false,
            "properties": {
              "scored": {"type": "integer"},
              "unknown": {"type": "integer"},
              "excluded_not_applicable": {"type": "integer"},
              "distribution": {"type": "object", "additionalProperties": {"type": "integer"}},
              "mean_of_scored": {"type": ["number", "null"]}
            }
          }
        }
      }
    },
    "totals": {"type": "object", "additionalProperties": {"type": ["integer", "object"]}}
  }
}
